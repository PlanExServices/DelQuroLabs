# Copy to .env and adjust. Never commit the real .env.
# Docker Compose and Coolify both read these variables.

# ---------------------------------------------------------------------------
# Public site configuration (baked in at build time by Vite)
# ---------------------------------------------------------------------------

# Sub-path to publish under. Keep "/" when the site owns the root domain,
# set e.g. "/labs/" when it is served under https://example.com/labs/.
VITE_BASE=/

# Public URL of this deployment. Used for the DelQuroLabs entry in the
# Projects portfolio section. Include the trailing slash.
VITE_SITE_URL=https://example.com/

# ---------------------------------------------------------------------------
# Container / reverse proxy
# ---------------------------------------------------------------------------

# Port the container listens on internally (image default: 8080).
APP_PORT=8080

# Port published on the *private server's* own network interface.
# Bind to 127.0.0.1 when a reverse proxy (Traefik, Caddy, nginx) sits in
# front of it and is the only thing that should be reachable.
HOST_BIND=127.0.0.1
HOST_PORT=8080

# ---------------------------------------------------------------------------
# Coolify deployment (docker-compose.coolify.yml)
# ---------------------------------------------------------------------------

# Container name Coolify routes to. Must match the auto-generated container
# name shown in your Coolify service page — look under
# "Configuration -> General -> Container name" or run `docker ps` on the host.
COOLIFY_CONTAINER_NAME=delqurolabs-<generated-id>

# Traefik entrypoints and certificate resolver configured in Coolify.
COOLIFY_ENTRYPOINT=https
COOLIFY_HTTP_ENTRYPOINT=http
COOLIFY_CERT_RESOLVER=letsencrypt

# Docker network Coolify's proxy lives on (default: coolify).
COOLIFY_NETWORK=coolify

# Public hostname served by Traefik — must match the domain in Coolify's UI.
SITE_DOMAIN=delqurolabs.example.com

TZ=UTC

# ---------------------------------------------------------------------------
# Prebuilt image deployment (no build on the server)
# ---------------------------------------------------------------------------

# Set after the first CI run pushes to GHCR, e.g.
# ghcr.io/planexservices/delqurolabs:latest
IMAGE=ghcr.io/planexservices/delqurolabs:latest

# If the GHCR package is private, Coolify needs a token to pull it.
# REGISTRY_USERNAME=planexservices
# REGISTRY_PASSWORD=
